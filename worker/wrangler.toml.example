name = "shanghan-bianzheng-api"
main = "worker.js"
compatibility_date = "2026-10-20"

# 把仓库根目录的 index.html 作为文本模块打进 Worker（一体化部署：/ 直接返回该页面）
rules = [{ type = "Text", globs = ["**/*.html"], fallthrough = true }]

# Do NOT put secrets in this file, not even in commented examples.
[vars]
# DeepSeek（OpenAI 兼容）为本项目默认提供商；也可换回 OpenAI 或其他兼容网关
OPENAI_MODEL = "deepseek-chat"
OPENAI_BASE_URL = "https://api.deepseek.com/v1"
OPENAI_JSON_MODE = "true"
# 仅当网页部署在其他域名（如 GitHub Pages）时才需要 ALLOWED_ORIGIN；一体化部署留空即可
# ALLOWED_ORIGIN = "https://liuchengxiang2023.github.io"
# Require a strong SITE_ACCESS_CODE secret. Set with:
# npx wrangler secret put OPENAI_API_KEY
# npx wrangler secret put SITE_ACCESS_CODE
